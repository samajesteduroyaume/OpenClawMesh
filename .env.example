# OpenClawMesh production configuration
# Copy to .env and replace every placeholder before deployment.

OPENCLAW_DEFAULT_HOST=127.0.0.1
OPENCLAW_DEFAULT_PORT=8770
OPENCLAW_PSK=replace-with-a-long-random-secret
OPENCLAW_TASK_TIMEOUT=120
OPENCLAW_MAX_ACTIVE_TASKS=100

# Gateway
GATEWAY_ADMIN_TOKEN=replace-with-a-long-random-admin-secret
GATEWAY_DB_PATH=./data/openclaw_keys.db
GATEWAY_CORS_ORIGINS=https://your-domain.example
BTC_WALLET_ADDRESS=replace-with-your-bitcoin-address
BTC_AUTO_VERIFY=true
BTC_REQUIRED_CONFIRMATIONS=2
BTC_VERIFY_INTERVAL_SECONDS=30
BTC_EXPLORER_URL=https://mempool.space/api
BTC_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=eur
# Optionnel: plusieurs URLs séparées par des virgules; la médiane est retenue.
# BTC_PRICE_URLS=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=eur,https://api.coinbase.com/v2/prices/BTC-EUR/spot
BTC_PRICE_FALLBACK_EUR=67642
BTC_PRICE_CACHE_SECONDS=300

# Amount overrides are optional. Leave unset to calculate from the price oracle.
# BTC_PLAN_MIN_SATS={"pro_monthly":14784,"lifetime":295674}

# WAN relay: required when relay_host is not localhost.
OPENCLAW_RELAY_AUTH_TOKEN=replace-with-a-long-random-relay-secret
